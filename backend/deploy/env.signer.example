# /etc/fees/signer.env  — ON THE SIGNER HOST ONLY. Readable only by the fees-signer user (chmod 600).
# This is the ONLY place private keys are referenced. The API and worker never see these paths.

NODE_ENV=production
DB_DRIVER=memory                 # the signer has no database
RPC_URL=https://mainnet.helius-rpc.com/?api-key=REPLACE_ME
RPC_COMMITMENT=confirmed
EXPECTED_GENESIS=5eykt4UsFv8P8NJdTREpY1vzqKqZKvdpKuc147dw2N9d   # mainnet-beta
CLUSTER=mainnet

# Public keys (must match the keypair files below).
LAUNCH_WALLET_PUBKEY=REPLACE_LAUNCH_PUBKEY
CRANK_WALLET_PUBKEY=REPLACE_CRANK_PUBKEY
BUYBACK_DEST=REPLACE_BUYBACK_PUBKEY

# Signer HTTP endpoint (bind localhost; only the API/worker on this host reach it).
SIGNER_PORT=8091
SIGNER_TOKEN=REPLACE_LONG_RANDOM_SHARED_SECRET

# Key files — absolute paths OUTSIDE any repo, owned by fees-signer, chmod 600.
LAUNCH_KEYPAIR_PATH=/etc/fees/keys/launch.json
CRANK_KEYPAIR_PATH=/etc/fees/keys/crank.json
# BUYBACK_KEYPAIR_PATH=/etc/fees/keys/buyback.json   # only when buyback is enabled later
