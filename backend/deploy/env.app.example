# /etc/fees/app.env  — shared by the API and the worker. Contains NO private keys.
# Readable by the fees-app user (chmod 600).

NODE_ENV=production
DB_DRIVER=pg
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/fees?sslmode=require

RPC_URL=https://mainnet.helius-rpc.com/?api-key=REPLACE_ME
RPC_COMMITMENT=confirmed
EXPECTED_GENESIS=5eykt4UsFv8P8NJdTREpY1vzqKqZKvdpKuc147dw2N9d
CLUSTER=mainnet

# Wallets — PUBLIC KEYS ONLY.
LAUNCH_WALLET_PUBKEY=REPLACE_LAUNCH_PUBKEY
CRANK_WALLET_PUBKEY=REPLACE_CRANK_PUBKEY
BUYBACK_DEST=REPLACE_BUYBACK_PUBKEY
LAUNCH_ALT_ADDRESS=            # set after `npm run init-alt`

# Signer (separate process; API/worker call it, never hold keys).
SIGNER_MODE=http
SIGNER_URL=http://127.0.0.1:8091
SIGNER_TOKEN=REPLACE_LONG_RANDOM_SHARED_SECRET   # must equal the signer's SIGNER_TOKEN

# API
PORT=8080
API_TOKEN=REPLACE_LONG_RANDOM_API_TOKEN          # bearer the BFF/edge function presents
CORS_ORIGINS=                                    # leave EMPTY if the browser never calls the API directly (recommended)

# Launch safety — KEEP FALSE until go-live is approved.
LAUNCH_ENABLED=false
DEFAULT_DEV_BUY_LAMPORTS=500000000               # 0.5 SOL
MAX_DEV_BUY_LAMPORTS=2000000000                  # 2 SOL cap
LAUNCH_PRIORITY_FEE_MICROLAMPORTS=200000         # set >0 for mainnet landing (stays under 1232 B)
LAUNCH_CU_LIMIT=0
LAUNCH_INTENT_TTL_SECONDS=90
LAUNCH_MAX_SUBMIT_ATTEMPTS=3
LAUNCH_CONFIRM_TIMEOUT_MS=45000

# Worker
EPOCH_INTERVAL_MS=3600000                        # hourly
EPOCH_MIN_DISTRIBUTABLE_LAMPORTS=1000000

# Explorer
SOLSCAN_BASE=https://solscan.io

# Buyback — leave OFF. Enable only after $FEES ships (see DEPLOYMENT.md §9).
BUYBACK_ENABLED=false
# NOTE: FEES_MINT_ADDRESS is NOT an env var. It lives in lib/constants.mjs and stays null until $FEES ships.
